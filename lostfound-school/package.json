{
  "name": "lostfound-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "supabase": "node node_modules/supabase/dist/supabase.js",
    "check:env": "node --experimental-strip-types scripts/check-env.ts",
    "test:staging:register": "node --env-file-if-exists=.env --env-file-if-exists=.env.staging --experimental-strip-types --test integration/register.test.ts",
    "test:staging": "node --env-file-if-exists=.env --env-file-if-exists=.env.staging --experimental-strip-types --test integration/workflow.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "lucide-react": "^0.468.0",
    "multer": "2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "supabase": "3.1.0",
    "supertest": "7.3.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
