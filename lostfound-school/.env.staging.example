# Copy to .env.staging (gitignored). Also configure .env from .env.example.
# This file is for live tests ONLY. Never set these flags for production.
APP_ENV=staging
RUN_STAGING_TESTS=no
STAGING_PROJECT_REF=

# Four distinct inboxes you control. Use fresh staging-only passwords, >=12 chars.
# Allowlist only A, B and ADMIN. OUTSIDER must stay outside the school allowlist.
STAGING_STUDENT_A_EMAIL=
STAGING_STUDENT_A_PASSWORD=
STAGING_STUDENT_B_EMAIL=
STAGING_STUDENT_B_PASSWORD=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_OUTSIDER_EMAIL=
STAGING_OUTSIDER_PASSWORD=
