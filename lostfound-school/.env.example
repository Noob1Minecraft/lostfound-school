# Browser: public configuration only. Never prefix a secret with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local Vite proxies /api to port 3001. Production: https://YOUR-API.onrender.com/api
VITE_API_URL=/api

# Backend: same project URL and publishable key, plus a SERVER-ONLY secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret/service-role key, used only for sanitized Storage writes.
# Leave empty to disable uploads; listing/auth workflows still work.
SUPABASE_STORAGE_SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
# Set to the verified proxy hop count for hosting; use 0 for local development.
TRUST_PROXY_HOPS=0
